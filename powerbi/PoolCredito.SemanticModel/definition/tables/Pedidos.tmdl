	partition Pedidos = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents("C:\Users\roman.lopez\Documentos\Claude\Order-Pool-Monitoring-Pipeline\data\gold\fact_pedido_pool.csv"),[Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.None]),
				    #"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    #"Changed Type" = Table.TransformColumnTypes(#"Promoted Headers",{{"pedido", type text}, {"cliente_key", Int64.Type}, {"analista_key", Int64.Type}, {"motivo_key", Int64.Type}, {"estatus_key", Int64.Type}, {"fecha_creacion_key", type date}, {"fecha_liberacion_key", type date}, {"fecha_cancelacion_key", type date}, {"creado_en", type datetime}, {"liberado_fecha", type datetime}, {"cancelado_fecha", type datetime}, {"valor_pedido", Currency.Type}, {"minutos_liberacion", Int64.Type}, {"minutos_cancelacion", Int64.Type}, {"indicador_liberado", type logical}, {"indicador_cancelado", type logical}, {"indicador_en_pool", type logical}, {"estatus_fue_reconstruido", type logical}, {"usuario_no_catalogado", type logical}}),
				    #"Removed Columns" = Table.RemoveColumns(#"Changed Type",{"creado_en", "liberado_fecha", "cancelado_fecha"}),
				    #"Renamed Columns" = Table.RenameColumns(#"Removed Columns",{{"pedido", "Pedido"}, {"cliente_key", "Cliente Key"}, {"analista_key", "Analista Key"}, {"motivo_key", "Motivo Key"}, {"estatus_key", "Estatus Key"}, {"fecha_creacion_key", "Fecha Creacion Key"}, {"fecha_liberacion_key", "Fecha Liberacion Key"}, {"fecha_cancelacion_key", "Fecha Cancelacion Key"}, {"valor_pedido", "Valor Pedido"}, {"minutos_liberacion", "Minutos Liberacion"}, {"minutos_cancelacion", "Minutos Cancelacion"}, {"indicador_liberado", "Indicador Liberado"}, {"indicador_cancelado", "Indicador Cancelado"}, {"indicador_en_pool", "Indicador En Pool"}, {"estatus_fue_reconstruido", "Estatus Fue Reconstruido"}, {"usuario_no_catalogado", "Usuario No Catalogado"}})
				in
				    #"Renamed Columns"

